# name: test/sql/snowflake_catalog_columns.test
# description: Catalog column lists are populated at schema-load time, before any table scan
# group: [sql]

#
# SnowflakeTableEntry used to leave TableCatalogEntry::columns empty until the
# first GetScanFunction bind. DESCRIBE / duckdb_columns() / pragma_show then
# returned no columns, so clients had to wait for a real SELECT to learn the
# schema. LoadEntries now fills columns from INFORMATION_SCHEMA.COLUMNS (one
# query per schema). Arrow bind schema stays lazy via ViaQuery (#44 / geometry).
#
# Creates its own fixture in SNOWFLAKE_DATABASE so it does not depend on
# sample-data schemas like TPCH_SF1.

require snowflake

require-env SNOWFLAKE_ACCOUNT

require-env SNOWFLAKE_USERNAME

require-env SNOWFLAKE_PRIVATE_KEY_FILE

require-env SNOWFLAKE_PRIVATE_KEY_PASSWORD_FILE

require-env SNOWFLAKE_DATABASE

statement ok
CREATE SECRET sf_cols_secret (
    TYPE snowflake,
    ACCOUNT '${SNOWFLAKE_ACCOUNT}',
    USER '${SNOWFLAKE_USERNAME}',
    AUTH_TYPE 'key_pair',
    PRIVATE_KEY_FILE '${SNOWFLAKE_PRIVATE_KEY_FILE}',
    PRIVATE_KEY_PASSWORD '${SNOWFLAKE_PRIVATE_KEY_PASSWORD_FILE}',
    DATABASE '${SNOWFLAKE_DATABASE}'
);

statement ok
SELECT * FROM snowflake_query('CREATE SCHEMA IF NOT EXISTS ${SNOWFLAKE_DATABASE}.DUCKDB_CATALOG_TEST', 'sf_cols_secret');

statement ok
SELECT * FROM snowflake_query('CREATE OR REPLACE TABLE ${SNOWFLAKE_DATABASE}.DUCKDB_CATALOG_TEST.COLS (ID NUMBER(38,0), NAME VARCHAR, AMOUNT NUMBER(12,2), CREATED_AT TIMESTAMP_NTZ)', 'sf_cols_secret');

statement ok
SELECT * FROM snowflake_query('INSERT INTO ${SNOWFLAKE_DATABASE}.DUCKDB_CATALOG_TEST.COLS VALUES (1, ''alice'', 12.50, ''2026-02-09 05:07:34.488000''::TIMESTAMP_NTZ), (2, ''bob'', 3.25, ''2025-10-07 07:20:12.488000''::TIMESTAMP_NTZ)', 'sf_cols_secret');

statement ok
ATTACH '' AS sf_cols (TYPE SNOWFLAKE, SECRET sf_cols_secret, READ_ONLY);

# duckdb_columns() is the backend catalog path (no DESCRIBE, no table scan).
# This must be the first introspection after ATTACH so it cannot ride on
# DESCRIBE having already published columns.
query TT
SELECT column_name, data_type FROM duckdb_columns()
WHERE database_name = 'sf_cols' AND schema_name = 'DUCKDB_CATALOG_TEST' AND table_name = 'COLS'
ORDER BY column_name;
----
AMOUNT	DECIMAL(12,2)
CREATED_AT	TIMESTAMP
ID	DECIMAL(38,0)
NAME	VARCHAR

# DESCRIBE must work immediately after ATTACH — no prior SELECT on COLS
query I
SELECT COUNT(*) FROM (DESCRIBE sf_cols.DUCKDB_CATALOG_TEST.COLS);
----
4

query TT
SELECT column_name, column_type FROM (DESCRIBE sf_cols.DUCKDB_CATALOG_TEST.COLS) ORDER BY column_name;
----
AMOUNT	DECIMAL(12,2)
CREATED_AT	TIMESTAMP
ID	DECIMAL(38,0)
NAME	VARCHAR

# Scan still works after the eager catalog load (COUNT(*) hits a virtual-column
# path that needs pushdown; COUNT(ID) is the catalog-scan check)
query I
SELECT COUNT(ID) FROM sf_cols.DUCKDB_CATALOG_TEST.COLS;
----
2

query TTT
SELECT ID, NAME, AMOUNT FROM sf_cols.DUCKDB_CATALOG_TEST.COLS ORDER BY ID;
----
1	alice	12.50
2	bob	3.25

query I
SELECT typeof(CREATED_AT) FROM sf_cols.DUCKDB_CATALOG_TEST.COLS WHERE ID = 1;
----
TIMESTAMP

statement ok
SELECT * FROM snowflake_query('DROP TABLE IF EXISTS ${SNOWFLAKE_DATABASE}.DUCKDB_CATALOG_TEST.COLS', 'sf_cols_secret');
